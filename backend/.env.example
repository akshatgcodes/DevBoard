# Postgres in production (Neon etc.). Leave unset to use a local SQLite file.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/devboard

# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/auth/github/callback

# Signs the session cookie. Any long random string.
SESSION_SECRET=change-me

# Where the React app runs (CORS + post-login redirect)
FRONTEND_URL=http://localhost:5173

# true in production when frontend and API are on different domains
CROSS_SITE_COOKIES=false

# Lets you log in as any GitHub username without OAuth. Local dev only.
DEV_LOGIN=true
